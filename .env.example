# Copie este arquivo para .env e preencha as chaves necessárias.
# O .env está no .gitignore — chave nunca vai para o repositório.

# --- Embeddings (obrigatório): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- LLM do card de insights: "deepseek" (padrão) ou "gemini"
# Para deepseek, a chave sai em https://platform.deepseek.com
DEEPSEEK_API_KEY=
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash          # alias legado aceito: deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT=60                    # segundos; evita chamada pendurada
# LLM_MAX_ATTEMPTS=4
# LLM_RETRY_SLEEP=10

# --- Modelo de embeddings e ritmo da ingestão (free tier do Gemini)
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_BATCH_CHARS=16000
# EMBEDDING_BATCH_DELAY=10
