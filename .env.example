# Copie este arquivo para .env e preencha com sua chave do Google AI Studio.
# A chave sai em https://aistudio.google.com/apikey
# O .env está no .gitignore — a chave nunca vai para o repositório.
GOOGLE_API_KEY=

# Opcional: sobrescreve os modelos padrão (sondados em set/2026 com free tier).
# EMBEDDING_MODEL=gemini-embedding-001
# LLM_MODEL=gemini-3.6-flash
